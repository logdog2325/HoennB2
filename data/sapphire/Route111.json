   "script": "Route111_EventScript_15046F",
   "texts": {
    "Route111_Text_1BB250": "To train myself, I challenge all\\nwhom I meet!$",
    "Route111_Text_1BB27E": "Uncle! I give up!$",
    "Route111_Text_1BB290": "All I can do is keep training until\\nI can defeat strong TRAINERS such\\las yourself.$"
