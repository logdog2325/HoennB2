   "hide_flag": "0",
   "script": "Route103_EventScript_14EDF1",
   "texts": {
    "Route103_Text_1B7EFB": "LIV: We battle together as one\\nteam.$",
    "Route103_Text_1B7F20": "LIV: Oh, we lost, big sister...$",
    "Route103_Text_1B7F8E": "LIV: If you want to battle us, you\\nhave to have two POKéMON!\\lIt's not fair if you don't!$",
    "Route103_Text_1B7F40": "LIV: We work perfectly together, me\\nand my big sister...\\pBut we still lost...$"
   },
   "complex": true
  },
  {
   "local_id": 5,
   "x": 64,
