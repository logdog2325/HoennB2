   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route106_EventScript_14F338",
   "texts": {
    "Route106_Text_1B913D": "Hahahah! I'm a lousy runner, but in\\nthe water you can't catch me!$",
    "Route106_Text_1B917F": "I give up!$",
    "Route106_Text_1B918A": "I wouldn't lose in a swim race...$"
   },
   "complex": true
  },
  {
   "local_id": 2,
   "x": 18,
   "y": 5,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_F",
   "movement": "MOVEMENT_TYPE_LOOK_AROUND",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route106_EventScript_14F34F",
   "texts": {
    "Route106_Text_1B91AC": "The sea is my backyard. I'm not going\\nto take it easy because you're a kid!$",
    "Route106_Text_1B91F8": "Did you take it easy on me by any\\nchance?$",
    "Route106_Text_1B9222": "Drifting along with the waves...\\nI love it! Why don't you give it a try?$"
   },
   "complex": true
  },
  {
   "local_id": 3,
   "x": 51,
   "y": 14,
   "gfx": "OBJ_EVENT_GFX_FISHERMAN",
   "movement": "MOVEMENT_TYPE_FACE_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route106_EventScript_14F366",
   "texts": {
    "Route106_Text_1B8EF0": "Which do you prefer, fishing in the\\nsea or a stream?$",
    "Route106_Text_1B8F25": "Like in deep-sea fishing, I lost\\nspectacularly!$",
    "Route106_Text_1B8F55": "Fishing is the greatest whether it's\\nin the sea or a stream.\\lYou agree with me, right?$"
   },
   "complex": true
  },
  {
   "local_id": 4,
   "x": 65,
   "y": 14,
   "gfx": "OBJ_EVENT_GFX_FISHERMAN",
   "movement": "MOVEMENT_TYPE_LOOK_AROUND",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route106_EventScript_14F3A4",
   "texts": {
    "Route106_Text_1B9052": "What do people do if they need to go\\nto a washroom?\\pWhat if my ROD hooks a big one while\\nI'm in the washroom? I just can't go...$",
    "Route106_Text_1B90D3": "I lost because I'm trying to not go\\nto the washroom...$",
    "Route106_Text_1B910A": "Oh, no! I've got this feeling I'll hook\\na big one!$"
   },
   "complex": true
