   "script": "MossdeepCity_EventScript_NinjaBoy",
   "texts": {
    "MossdeepCity_Text_WailmerWatching": "Around MOSSDEEP, you can see wild\\nWAILMER.\\pIt's called, uh...\\nWhat was it now...\\pWAI, WAI, WAI...\\pWAILMER watching!$"
