   "hide_flag": "0",
   "script": "Route110_EventScript_14F9CB",
   "texts": {
    "Route110_Text_16EE74": "Learning techniques will make BIKE\\nriding even more fun.\\pThere are some places that you can\\nreach only by using a BIKE technique.$"
