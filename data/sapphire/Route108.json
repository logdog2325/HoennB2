   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route108_EventScript_14F4BB",
   "texts": {
    "Route108_Text_1B9986": "I love the sea!\\nI forget all my worries when I swim!$",
