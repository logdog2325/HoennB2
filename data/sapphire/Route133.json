   "texts": {
    "Route133_Text_1C2DA5": "Did the currents carry you here, too?\\nThis must have been fated. Let's battle!$",
    "Route133_Text_1C2DF4": "Strong!\\nToo much so!$",
    "Route133_Text_1C2E09": "It's just my luck that a tough TRAINER\\nlike you would drift here...\\lI must be cursed...$"
