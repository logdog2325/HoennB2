   "script": "Route116_EventScript_150CE5",
   "texts": {
    "Route116_Text_1BD131": "Let me teach you how strong my\\nadorable POKéMON is!$",
    "Route116_Text_1BD165": "You're a notch above me...$",
    "Route116_Text_1BD180": "POKéMON that possess cuteness and\\npower, that's ideal, I think.$"
   },
   "complex": true
  },
  {
   "local_id": 17,
   "x": 25,
   "y": 4,
   "gfx": "OBJ_EVENT_GFX_GIRL_3",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
