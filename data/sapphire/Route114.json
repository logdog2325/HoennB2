   "script": "Route114_EventScript_15088B",
   "texts": {
    "Route114_Text_1BC45A": "If you're lighting a campfire, make\\nsure you have water handy.$",
    "Route114_Text_1BC499": "Thanks for dousing my fire!$",
    "Route114_Text_1BC4B5": "You really do have to be careful with\\nany sort of fire in a forest.\\pDon't ever underestimate the power\\nof fire.$"
   },
