   "hide_flag": "0",
   "script": "Route118_EventScript_1510CD",
   "texts": {
    "Route118_Text_1BE24A": "I'm a FISHERMAN, but also a TRAINER.\\nI'm raising the POKéMON I caught.$",
    "Route118_Text_1BE291": "I thought I was doing okay in my\\ntraining...$",
    "Route118_Text_1BE2BE": "I couldn't win by training POKéMON\\nwhile I fished...\\pWas I doing things in half measures?$"
   },
   "complex": true
  },
