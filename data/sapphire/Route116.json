    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route116_EventScript_150CFC",
   "texts": {
    "Route116_Text_1BD377": "I study at school, and I study on the\\nway home, too!$",
    "Route116_Text_1BD3AC": "I'm in shock - I lost?$",
    "Route116_Text_1BD3C3": "Awww, I'll never become an elegant\\nTRAINER like ROXANNE this way!$"
   },
   "complex": true
  },
  {
   "local_id": 18,
   "x": 31,
   "y": 9,
   "gfx": "OBJ_EVENT_GFX_SCHOOL_KID_M",
   "movement": "MOVEMENT_TYPE_FACE_LEFT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route116_EventScript_150C90",
   "texts": {
    "Route116_Text_1BD1C0": "We learn all sorts of things at the\\nTRAINER'S SCHOOL.\\pI want to test things out for real!$",
    "Route116_Text_1BD21A": "I slacked off in school...\\nThat's why I lost.$",
    "Route116_Text_1BD248": "I'll have to redo some courses at the\\nTRAINER'S SCHOOL.\\lIf I don't, ROXANNE will be steamed.$"
   },
   "complex": true
  },
  {
   "local_id": 19,
   "x": 46,
   "y": 11,
   "gfx": "OBJ_EVENT_GFX_MAN_2",
