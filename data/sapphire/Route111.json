   "script": "Route111_EventScript_1504C4",
   "texts": {
    "Route111_Text_1BB44F": "Oh, your POKéMON look like serious\\nactors.\\lI have to ask you for an engagement.$",
    "Route111_Text_1BB49F": "They didn't just look strong, they\\nare strong!$",
    "Route111_Text_1BB4CE": "I thought I was raising my POKéMON\\ndiligently, but, oh no, there is still\\lmuch to be done.$"
   },
   "complex": true
  },
