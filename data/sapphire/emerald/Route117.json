   "hide_flag": "0",
   "script": "Route117_EventScript_Meg",
   "texts": {
    "Route117_Text_MegIntro": "MEG: I'm going to tag up with my super\\nsenior student partner and beat you!$",
    "Route117_Text_MegDefeat": "MEG: Oh, no!\\nI'm sorry, ANNA! I let you down…$",
    "Route117_Text_MegNotEnoughMons": "MEG: Do you only have one POKéMON?\\nWe can't battle with you, then.\\pWe want to have a 2-on-2 battle.$",
    "Route117_Text_MegPostBattle": "MEG: I dragged ANNA down…\\nIf I didn't, she would have won!$"
   },
   "complex": true
  },
  {
