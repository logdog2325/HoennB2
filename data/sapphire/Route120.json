    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route120_EventScript_151A36",
   "texts": {
    "Route120_Text_1BF32B": "... ... ... ... ... ...\\n... ... ... ... ... ...\\lWant to battle?$",
    "Route120_Text_1BF36B": "... ... ... ... ... ...\\nI lost...$",
    "Route120_Text_1BF38D": "... ... ... ... ... ...\\n... ... ... ... ... ...\\lI'll try harder...$"
