    1
   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "0",
   "script": "Route111_EventScript_150395",
   "texts": {
    "Route111_Text_16FB86": "If you don't raise your POKéMON some\\nmore, it could be tough to keep winning\\lup through the ranks.\\pI've heard the POKéMON LEAGUE's\\nELITE FOUR are far stronger than\\lany GYM LEADER.$"
   }
  },
  {
   "local_id": 9,
   "x": 24,
   "y": 60,
   "gfx": "OBJ_EVENT_GFX_CAMPER",
   "movement": "MOVEMENT_TYPE_FACE_UP_LEFT_AND_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route111_EventScript_1503A7",
   "texts": {
    "Route111_Text_1BAB4B": "Oh, hey! Those GO-GOGGLES suit you.\\nBut I think they look better on me.\\pLet's decide who they look better on\\nwith a battle!$",
    "Route111_Text_1BABC7": "I couldn't see what was happening at my\\nsides because of the GO-GOGGLES.$",
    "Route111_Text_1BAC10": "The GO-GOGGLES make it possible to\\nget through sandstorms.\\lThat makes me happy!$"
   },
   "complex": true
  },
  {
   "local_id": 10,
   "x": 27,
   "y": 69,
   "gfx": "OBJ_EVENT_GFX_HIKER",
   "movement": "MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_LEFT_UP_RIGHT",
   "range": [
    2,
    2
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route111_EventScript_150403",
   "texts": {
    "Route111_Text_1BAEC9": "For thirty years I have searched for\\nancient ruins!\\lI am to be challenged?$",
    "Route111_Text_1BAF14": "While I have searched for ruins, I've\\nnot searched for strong POKéMON.$",
    "Route111_Text_1BAF5B": "For thirty years I have searched for\\nancient ruins!\\pNo, wait, was that forty years?\\nWhich was it now?$"
   },
   "complex": true
  },
  {
   "local_id": 11,
   "x": 21,
   "y": 47,
   "gfx": "OBJ_EVENT_GFX_CAMPER",
   "movement": "MOVEMENT_TYPE_FACE_LEFT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route111_EventScript_1503D5",
   "texts": {
    "Route111_Text_1BAD4B": "Wearing these GO-GOGGLES makes me\\nfeel like a superhero.\\lRight now, nobody can beat me!$",
    "Route111_Text_1BADA3": "I can't win on spirit alone...$",
    "Route111_Text_1BADC2": "I'm going to be a real hero one day.\\nI'm going to work harder to make me\\land my POKéMON stronger.$"
   },
   "complex": true
  },
  {
   "local_id": 12,
   "x": 32,
   "y": 72,
   "gfx": "OBJ_EVENT_GFX_PICNICKER",
   "movement": "MOVEMENT_TYPE_ROTATE_CLOCKWISE",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route111_EventScript_1503EC",
   "texts": {
    "Route111_Text_1BAE24": "I heard there are fossils to be found\\nin the desert. Where could they be?$",
    "Route111_Text_1BAE6E": "I came up short...$",
    "Route111_Text_1BAE81": "If they can find fossils in the desert,\\nit must have been a sea before.$"
   },
   "complex": true
  },
