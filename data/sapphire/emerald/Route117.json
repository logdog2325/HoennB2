   "hide_flag": "0",
   "script": "Route117_EventScript_Derek",
   "texts": {
    "Route117_Text_DerekIntro": "Once a BUG CATCHER!\\nAnd now a BUG MANIAC!\\pBut my love for POKéMON remains\\nunchanged!$",
    "Route117_Text_DerekDefeat": "My ineptitude also remains\\nunchanged…$",
    "Route117_Text_DerekPostBattle": "All I did was follow my heart, and now\\nthey call me a BUG MANIAC…\\pStill, I am an expert on BUG POKéMON,\\nso it's only natural that they call me\\la BUG MANIAC.$"
   },
   "complex": true
  },
