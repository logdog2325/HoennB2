   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route105_EventScript_Beverly",
   "texts": {
    "Route105_Text_BeverlyIntro": "My body feels lighter in the water.\\nIt's as if I've gotten slimmer!$",
    "Route105_Text_BeverlyDefeated": "I'm floating…$",
    "Route105_Text_PostBattle": "Your body weight is reduced to just\\none tenth in the water.\\pThat would make me…\\nWhoops! I'm not telling you my weight!$"
   },
   "complex": true
  },
  {
