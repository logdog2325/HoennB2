   "range": [
    5,
    2
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route129_EventScript_15237D",
   "texts": {
    "Route129_Text_1C21ED": "I'm in the middle of a triathlon, but,\\nsure, why don't we battle?$",
    "Route129_Text_1C222F": "I was sure I'd win!$",
    "Route129_Text_1C2243": "Do you know what's the greatest thing\\nabout triathlons?\\pTesting the limits of your own\\nstrength and endurance against\\lMother Nature!$"
   },
   "complex": true
  },
  {
   "local_id": 3,
   "x": 9,
   "y": 14,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_F",
   "movement": "MOVEMENT_TYPE_LOOK_AROUND",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route129_EventScript_1523AB",
   "texts": {
    "Route129_Text_1C2349": "What's the hurry?\\nLet's take it slow and easy.$",
    "Route129_Text_1C2378": "Oh, my.\\nI wanted to relax a little more...$",
    "Route129_Text_1C23A3": "Don't you hate making mistakes when\\nyou're in a rush?\\pThat's why I try to take things\\nslowly.$"
   },
   "complex": true
  },
  {
   "local_id": 4,
   "x": 28,
