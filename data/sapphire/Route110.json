   "hide_flag": "0",
   "script": "Route110_EventScript_14FB7D",
   "texts": {
    "Route110_Text_1BA5FF": "I've been riding without stopping.\\nMy thighs are like rocks!$",
    "Route110_Text_1BA63C": "I'm worried about muscle cramps...$",
    "Route110_Text_1BA65F": "Oh, you have some GYM BADGES?\\nNo wonder you're so strong!$"
