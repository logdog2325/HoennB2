   "script": "MossdeepCity_EventScript_Scott",
   "texts": {
    "MossdeepCity_Text_ScottSomethingWrongWithTown": "SCOTT: {PLAYER}{KUN}, feeling good?\\nI'm doing great!\\pI'd heard MOSSDEEP's GYM LEADER is\\npretty strong, so I decided to come\\ltake a look-see for myself.\\pBut there's something wrong about\\nthis town.\\pPeople are going on about a warning\\nletter and the SPACE CENTER…\\pI don't think it concerns me in any\\nway, though.$"
   },
   "complex": true
  },
