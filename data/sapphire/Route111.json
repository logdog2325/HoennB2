   "hide_flag": "0",
   "script": "Route111_EventScript_150441",
   "texts": {
    "Route111_Text_1BB111": "I'm full of pep!\\nAnd my POKéMON is peppy, too!$",
    "Route111_Text_1BB140": "My POKéMON lost its pep...$",
    "Route111_Text_1BB15B": "When I see a TRAINER with a lot of pep,\\nI can't help looking.$"
