   "gfx": "OBJ_EVENT_GFX_SWIMMER_M",
   "movement": "MOVEMENT_TYPE_ROTATE_CLOCKWISE",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route129_EventScript_152394",
   "texts": {
    "Route129_Text_1C22C8": "Say hey, hey!\\nLet's get on with it!$",
    "Route129_Text_1C22EC": "Beat, I'm beaten.\\nThat's it, done!$",
    "Route129_Text_1C230F": "There's nothing for a loser.\\nTime for me to beat it home.$"
   },
   "complex": true
