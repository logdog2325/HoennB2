   "script": "Route105_EventScript_Luis",
   "texts": {
    "Route105_Text_LuisIntro": "Whew! I was worried that a kid was\\ndrowning when I saw you.\\pYou seem to be okay, so what do you\\nsay to a battle?$",
    "Route105_Text_LuisDefeated": "Glub… Glub…$",
    "Route105_Text_LuisPostBattle": "If you are drowning, the signal is to\\nwave one arm toward the beach.$"
   },
   "complex": true
  },
  {
   "local_id": 2,
   "x": 27,
