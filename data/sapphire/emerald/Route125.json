   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Stan",
   "texts": {
    "Route125_Text_StanIntro": "Hey, there!\\nCheck out my sweet POKéMON!$",
    "Route125_Text_StanDefeat": "I floundered…$",
    "Route125_Text_StanPostBattle": "I was blown away by HORSEA's charm,\\nso I started swimming, too.$"
   },
   "complex": true
  },
  {
   "local_id": 3,
   "x": 38,
