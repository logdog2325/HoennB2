   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route124_EventScript_151E92",
   "texts": {
    "Route124_Text_1C0ABD": "RITA: Sigh...\\pHere I am in the sea, but who's with me?\\nMy little brother!\\pLet's battle so I won't have to dwell\\non that!$",
    "Route124_Text_1C0B36": "RITA: SAM! It's your fault we lost!\\nYou're in for it later!$",
    "Route124_Text_1C0BC8": "RITA: You're planning to battle us?\\nNot unless you have more POKéMON.$",
    "Route124_Text_1C0B72": "RITA: Sigh...\\pIf only it wasn't my little brother\\nnext to me, but a nice boyfriend...$"
   },
   "complex": true
  },
  {
   "local_id": 10,
   "x": 17,
   "y": 44,
   "gfx": "OBJ_EVENT_GFX_TUBER_M_SWIMMING",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route124_EventScript_151ED8",
   "texts": {
    "Route124_Text_1C0C0E": "SAM: My big sister is tough at POKéMON!\\pDon't cry when you lose!$",
    "Route124_Text_1C0C4F": "SAM: Uh-oh...\\nMy big sister will chew me out...$",
    "Route124_Text_1C0CE0": "SAM: Did you want to battle us?\\nBring some more POKéMON, then.$",
    "Route124_Text_1C0C7F": "SAM: My big sister is really scary\\nwhen she gets angry.\\pThat's why she doesn't have a\\nboyfriend.$"
   },
   "complex": true
  }
