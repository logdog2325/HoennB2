   "hide_flag": "0",
   "script": "Route110_EventScript_14FB94",
   "texts": {
    "Route110_Text_1BA4A0": "The triathlon is hard in the extreme.\\pYou have to complete the three events\\nof swimming, cycling, and running.$",
    "Route110_Text_1BA50F": "POKéMON battles are hard, too!$",
    "Route110_Text_1BA52E": "I'm exhausted, so I need a break.\\nIt's important to get proper rest.$"
