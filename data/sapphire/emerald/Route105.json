   "hide_flag": "0",
   "script": "Route105_EventScript_Andres",
   "texts": {
    "Route105_Text_AndresIntro": "I'm convinced that the sea keeps\\nsecrets from us.$",
    "Route105_Text_AndresDefeated": "Yes…\\nI am no good at battling…$",
    "Route105_Text_AndresPostBattle": "I'm sure there are many secrets to be\\ndiscovered in the world's seas.\\pI mean to find them all!$"
   },
   "complex": true
