   "script": "Route127_EventScript_15207A",
   "texts": {
    "Route127_Text_1C17A8": "I can see it in your face. You want\\nto challenge me.$",
    "Route127_Text_1C17DD": "Awawawawawa...$",
    "Route127_Text_1C17EC": "A well-played match leaves me feeling\\nrefreshed and serene.$"
   },
   "complex": true
  },
  {
   "local_id": 2,
   "x": 45,
