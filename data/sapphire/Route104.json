   "script": "Route104_EventScript_14F1A0",
   "texts": {
    "Route104_Text_1B8770": "Should I...\\nOr shouldn't I?\\pOkay, sure, I will battle!$",
    "Route104_Text_1B87A7": "I shouldn't have battled...$",
    "Route104_Text_1B87C3": "If you're faced with a decision and\\nyou let someone else choose for you,\\lyou will regret it, however things\\lturn out.$"
