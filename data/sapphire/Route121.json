   "hide_flag": "0",
   "script": "Route121_EventScript_151BDE",
   "texts": {
    "Route121_Text_1BFC36": "KATE: Together, we're fearless!\\nWe'll demonstrate how tough we are!$",
    "Route121_Text_1BFC7A": "KATE: I blew it in front of my junior\\nstudent partner...$",
    "Route121_Text_1BFD08": "KATE: If you've only got one POKéMON,\\nwe can't battle with you.\\pThat would be bullying.$",
    "Route121_Text_1BFCB3": "KATE: When someone's relying on me,\\nI get this urge to look cool in front\\lof them...$"
   },
   "complex": true
  },
  {
   "local_id": 11,
   "x": 40,
   "y": 9,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route121_EventScript_151BF9",
   "texts": {
    "Route121_Text_1BFD60": "JOY: Together, we're fearless!\\nWe'll demonstrate how tough we are!$",
    "Route121_Text_1BFDA3": "JOY: Please forgive me, KATE!$",
    "Route121_Text_1BFE0D": "JOY: You need at least two POKéMON\\nif you're going to challenge us!$",
    "Route121_Text_1BFDC1": "JOY: Ehehe, I'll have to train with KATE,\\nmy senior student partner, again.$"
   },
   "complex": true
  },
