   "script": "Route118_EventScript_151150",
   "texts": {
    "Route118_Text_1BE1D7": "Take flight!\\nMy BIRD POKéMON!$",
    "Route118_Text_1BE1F5": "They did take flight...$",
    "Route118_Text_1BE20D": "If they'd get stronger, they'd be able\\nto fly more freely...$"
   },
   "complex": true
  },
  {
   "local_id": 17,
