   "script": "PetalburgWoods_EventScript_15CCA8",
   "texts": {
    "PetalburgWoods_Text_194D92": "Hello, have you seen any POKéMON\\ncalled SHROOMISH around here?\\pI really love that POKéMON.$",
    "PetalburgWoods_Text_194DED": "I was going to ambush you, but you\\nhad to dawdle in PETALBURG WOODS\\lforever, didn't you?\\pI got sick of waiting, so here I am!$",
    "PetalburgWoods_Text_194E6B": "You! DEVON RESEARCHER!\\pHand over those papers!$",
    "PetalburgWoods_Text_194E9A": "Aiyeeeh!\\pYou're a POKéMON TRAINER, aren't you?\\nYou've got to help me, please!$",
    "PetalburgWoods_Text_194EE8": "Hunh? What do you think you're doing?\\nWhat, you're going to protect him?\\pNo one who crosses TEAM {EVIL_TEAM}\\ngets any mercy, not even a kid!\\pCome on and battle me!$",
    "PetalburgWoods_Text_194F83": "You're kidding me! You're tough!$"
   },
