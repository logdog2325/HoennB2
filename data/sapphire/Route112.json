   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route112_EventScript_150549",
   "texts": {
    "Route112_Text_1BB619": "Hahahaha!\\nHow about we have a battle?\\lYou and me!\\lHahahaha!$",
    "Route112_Text_1BB655": "I lost!\\nHahahaha!$",
    "Route112_Text_1BB667": "Hahahahaha! Something flew up my nose!\\nHahahaha-hatchoo!$"
