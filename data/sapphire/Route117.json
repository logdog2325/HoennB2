   "x": 21,
   "y": 1,
   "gfx": "OBJ_EVENT_GFX_RUNNING_TRIATHLETE_F",
   "movement": "MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_LEFT_UP",
   "range": [
    4,
    4
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150E47",
   "texts": {
    "Route117_Text_1BD914": "I do my triathlon training with POKéMON,\\nso I'm pretty confident about my speed.$",
    "Route117_Text_1BD965": "I need to get more practices in,\\nI guess.$",
    "Route117_Text_1BD98F": "Training is meaningful only if you\\nkeep it up regularly.\\pOkay! I'll resume my training!\\nTomorrow!$"
   },
   "complex": true
  },
  {
   "local_id": 18,
   "x": 17,
   "y": 12,
   "gfx": "OBJ_EVENT_GFX_MANIAC",
   "movement": "MOVEMENT_TYPE_FACE_UP",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150E85",
   "texts": {
    "Route117_Text_1BDAA7": "Once a BUG CATCHER!\\nAnd now a BUG MANIAC!\\pBut my love for POKéMON remains\\nunchanged!$",
    "Route117_Text_1BDAFC": "My ineptitude also remains\\nunchanged...$",
    "Route117_Text_1BDB24": "All I did was follow my heart, and now\\nthey call me a BUG MANIAC...\\pStill, I am an expert on BUG POKéMON,\\nso it's only natural that they call me\\la BUG MANIAC.$"
   },
   "complex": true
  },
  {
   "local_id": 19,
   "x": 46,
   "y": 15,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150EE2",
   "texts": {
    "Route117_Text_1BDCD2": "MEG: I'm going to tag up with my super\\nsenior student partner and beat you!$",
    "Route117_Text_1BDD1E": "MEG: Oh, no!\\nI'm sorry, ANNA! I let you down...$",
    "Route117_Text_1BDD8B": "MEG: Do you only have one POKéMON?\\nWe can't battle with you, then.\\pWe want to have a 2-on-2 battle.$",
    "Route117_Text_1BDD4E": "MEG: I dragged ANNA down...\\nIf I didn't, she would have won!$"
   },
   "complex": true
  },
  {
   "local_id": 20,
   "x": 45,
   "y": 15,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150E9C",
   "texts": {
    "Route117_Text_1BDBC3": "ANNA: I'm with my pretty junior student\\npartner. I have to do good!$",
    "Route117_Text_1BDC07": "ANNA: I'm with my pretty junior student\\npartner! Let me win!$",
    "Route117_Text_1BDC96": "ANNA: If you want to battle us, bring\\ntwo POKéMON with you.$",
    "Route117_Text_1BDC44": "ANNA: Your POKéMON have some good\\ncombinations.\\pI'd say you're second only to us!$"
   },
   "complex": true
  },
  {
   "local_id": 21,
   "x": 48,
   "y": 10,
   "gfx": "OBJ_EVENT_GFX_GIRL_2",
   "movement": "MOVEMENT_TYPE_WANDER_AROUND",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "0",
   "script": "Route117_EventScript_150D69",
   "texts": {
    "Route117_Text_170C26": "I left my POKéMON at the DAY CARE.\\pWhen I got it back, it had a new move\\nthat I didn't teach it.\\lI was really, really surprised.$"
   }
  }
