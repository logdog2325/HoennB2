    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route112_EventScript_1505B5",
   "texts": {
    "Route112_Text_1BB8F0": "When you're out on a picnic, why, you\\nsimply have to sing!\\lCome on, sing with me!$",
    "Route112_Text_1BB942": "Oh, you're so strong!$",
    "Route112_Text_1BB958": "It doesn't matter if you're good or bad\\nat singing or POKéMON.\\pIf you have the most fun, you win!$"
   },
   "complex": true
  },
  {
