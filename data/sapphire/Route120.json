   "script": "Route120_EventScript_151739",
   "texts": {
    "Route120_Text_1C58F1": "Give the case a shake, and out pops\\na {POKEBLOCK}...\\pAnd that {POKEBLOCK} is caught and eaten\\nby a POKéMON...\\pIt's an expression of love, isn't it?$"
   },
   "complex": true
