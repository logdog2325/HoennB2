   "script": "JaggedPass_EventScript_Eric",
   "texts": {
    "JaggedPass_Text_EricIntro": "MT. CHIMNEY's JAGGED PASS…\\pNow this is what I've always wanted\\nin a mountain.\\pThis jagged bumpiness…\\nIt rocks my soul!$",
    "JaggedPass_Text_EricDefeat": "Losing left me bitter!$",
    "JaggedPass_Text_EricPostBattle": "Yes, I did lose at POKéMON…\\pBut, when it comes to the love of\\nthe mountains, I have you beat!$"
   },
   "complex": true
  },
  {
   "local_id": 2,
   "x": 16,
   "y": 35,
   "gfx": "OBJ_EVENT_GFX_CAMPER",
   "movement": "MOVEMENT_TYPE_FACE_LEFT_AND_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "JaggedPass_EventScript_Ethan",
   "texts": {
    "JaggedPass_Text_EthanIntro": "JAGGED PASS is hard to walk on.\\nIt's a good place for training.$",
    "JaggedPass_Text_EthanDefeat": "It was all over while we were still\\ntrying to find a good footing…$",
    "JaggedPass_Text_EthanPostBattle": "If I had an ACRO BIKE, I'd be able to\\njump ledges.$"
   },
   "complex": true
  },
  {
   "local_id": 3,
   "x": 23,
