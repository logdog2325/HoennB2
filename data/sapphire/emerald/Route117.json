   "script": "Route117_EventScript_Maria",
   "texts": {
    "Route117_Text_MariaIntro": "I do my triathlon training with POKéMON,\\nso I'm pretty confident about my speed.$",
    "Route117_Text_MariaDefeat": "I need to get more practices in,\\nI guess.$",
    "Route117_Text_MariaPostBattle": "Training is meaningful only if you\\nkeep it up regularly.\\pOkay! I'll resume my training!\\nTomorrow!$"
