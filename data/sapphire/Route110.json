    10,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route110_EventScript_14FB28",
   "texts": {
    "Route110_Text_1BA2D4": "Yo, you!\\nCan you keep up with my speed?$",
    "Route110_Text_1BA2FC": "Crash and burn!$",
    "Route110_Text_1BA30C": "Speed alone won't let me win at POKéMON.\\nI need to reconsider this...$"
