   "hide_flag": "0",
   "script": "JaggedPass_EventScript_15D29C",
   "texts": {
    "JaggedPass_Text_195E9E": "This place isn't your casual hike.\\nIt's not suited for a picnic.$",
    "JaggedPass_Text_195EDF": "Ohhh, no!\\nThe ground is too bumpy...$",
    "JaggedPass_Text_195F04": "Did you know?\\pSome people cleverly ride their\\nbicycles up this horribly bumpy pass.$"
   },
   "complex": true
