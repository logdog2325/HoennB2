   "hide_flag": "0",
   "script": "Route103_EventScript_14EDAB",
   "texts": {
    "Route103_Text_1B7DF7": "AMY: I'm AMY.\\nAnd this is my little sister LIV.\\lWe battle together!$",
    "Route103_Text_1B7E3B": "AMY: Uh-oh, we lost.$",
    "Route103_Text_1B7EAC": "AMY: Uh-oh, you have only one\\nPOKéMON with you.\\lYou can't battle us like that.$",
    "Route103_Text_1B7E50": "AMY: You have to think about all\\nkinds of things when you're battling\\lagainst two TRAINERS.$"
   },
   "complex": true
  },
  {
   "local_id": 6,
