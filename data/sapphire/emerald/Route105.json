   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route105_EventScript_Dominik",
   "texts": {
    "Route105_Text_DominikIntro": "Swimming the deep blue sea…\\nIt feels the greatest!$",
    "Route105_Text_DominikDefeated": "I lost…\\nNow I'm feeling blue…$",
    "Route105_Text_DominikPostBattle": "Why is the sea blue?\\pI learned about that at the MUSEUM in\\nSLATEPORT, but I forgot.$"
   },
   "complex": true
  },
  {
   "local_id": 3,
   "x": 8,
   "y": 45,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_F",
   "movement": "MOVEMENT_TYPE_WALK_UP_AND_DOWN",
   "range": [
    0,
