   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Tanya",
   "texts": {
    "Route125_Text_TanyaIntro": "I'm tired of swimming.\\nAre you up for a battle with me?$",
    "Route125_Text_TanyaDefeat": "You're too much!$",
    "Route125_Text_TanyaPostBattle": "Whew…\\nWhich way is it to MOSSDEEP CITY?$"
   },
   "complex": true
  },
  {
   "local_id": 4,
   "x": 30,
   "y": 28,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_F",
   "movement": "MOVEMENT_TYPE_WALK_SEQUENCE_RIGHT_DOWN_LEFT_UP",
   "range": [
    9,
    9
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Sharon",
   "texts": {
    "Route125_Text_SharonIntro": "How would you like to take on the\\nWATER-type POKéMON I raised?$",
    "Route125_Text_SharonDefeat": "Lost it…$",
    "Route125_Text_SharonPostBattle": "Your power… You're the real deal.\\nI'm amazed!$"
   },
   "complex": true
  },
  {
   "local_id": 5,
   "x": 21,
   "y": 30,
   "gfx": "OBJ_EVENT_GFX_SAILOR",
   "movement": "MOVEMENT_TYPE_FACE_DOWN_AND_UP",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Ernest",
   "texts": {
    "Route125_Text_ErnestIntro": "Ahoy! I'm a buff, tough SAILOR!\\nI've braved the world's seas!$",
    "Route125_Text_ErnestDefeat": "Gwrroooar!\\nI couldn't win!$",
    "Route125_Text_ErnestPostBattle": "The tide ebbs and flows inside the\\nSHOAL CAVE.\\pBy the way, it's about six hours from\\nhigh tide to low tide. Did you know?$"
   },
   "complex": true
  },
  {
   "local_id": 6,
   "x": 17,
   "y": 19,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Kim",
   "texts": {
    "Route125_Text_KimIntro": "KIM: A funny old man lives in the\\nSHOAL CAVE. Someone told me.\\lAre you going to see him, too?$",
    "Route125_Text_KimDefeat": "KIM: I thought we would win.$",
    "Route125_Text_KimNotEnoughMons": "KIM: No, no, no! You need two POKéMON,\\nor it's just no good!$",
    "Route125_Text_KimPostBattle": "KIM: A funny old man lives in the\\nSHOAL CAVE, doesn't he?\\pLet's go see him, IRIS!$"
   },
   "complex": true
  },
  {
   "local_id": 7,
   "x": 18,
   "y": 19,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Iris",
   "texts": {
    "Route125_Text_IrisIntro": "IRIS: KIM, can you tell me what we're\\nlooking for out here?$",
    "Route125_Text_IrisDefeat": "IRIS: Oh, we came sort of close.$",
    "Route125_Text_IrisNotEnoughMons": "IRIS: Oh, we could never, ever do\\nanything like a 2-on-1 battle.$",
    "Route125_Text_IrisPostBattle": "IRIS: KIM, are we really going into\\nthe SHOAL CAVE?\\lWe'll get all wet.$"
   },
   "complex": true
  },
  {
   "local_id": 8,
   "x": 43,
   "y": 19,
   "gfx": "OBJ_EVENT_GFX_MAN_5",
   "movement": "MOVEMENT_TYPE_WALK_RIGHT_AND_LEFT",
   "range": [
    2,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_Presley",
   "texts": {
    "Route125_Text_PresleyIntro": "Why would a BIRDKEEPER like me\\ncome out to the sea?$",
    "Route125_Text_PresleyDefeat": "Okay.\\nI'll tell you why I'm here.$",
    "Route125_Text_PresleyPostBattle": "I put a message in a bottle and put\\nit out to sea.\\pI'm sure that a girl SWIMMER will\\nfind it!$"
   },
   "complex": true
  },
  {
   "local_id": 9,
   "x": 48,
