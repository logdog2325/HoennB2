  {
   "local_id": 24,
   "x": 28,
   "y": 35,
   "gfx": "OBJ_EVENT_GFX_WOMAN_7",
   "movement": "MOVEMENT_TYPE_FACE_UP_AND_LEFT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route120_EventScript_151A74",
   "texts": {
    "Route120_Text_1BF4A0": "POKéMON have many special abilities.\\nIf you want to become a first-class\\lTRAINER, learn about them.$",
    "Route120_Text_1BF504": "You're obviously thinking.$",
    "Route120_Text_1BF51F": "The special abilities of POKéMON\\nwill make battle styles change.$"
   },
   "complex": true
  },
  {
   "local_id": 25,
   "x": 9,
   "y": 60,
   "gfx": "OBJ_EVENT_GFX_HIKER",
   "movement": "MOVEMENT_TYPE_FACE_UP_LEFT_AND_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route120_EventScript_151A8B",
   "texts": {
    "Route120_Text_1BF560": "Who might you be?\\pAre you perhaps searching for ancient\\nruins that are rumored to possibly\\lexist according to legend?$",
    "Route120_Text_1BF5D6": "What a disgraceful setback...$",
    "Route120_Text_1BF5F4": "That giant rock... I would like to\\nbelieve it may indeed contain ancient\\lruins. But I see no entrance.$"
   },
   "complex": true
  },
  {
   "local_id": 26,
   "x": 16,
   "y": 6,
   "gfx": "OBJ_EVENT_GFX_WOMAN_7",
   "movement": "MOVEMENT_TYPE_ROTATE_COUNTERCLOCKWISE",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route120_EventScript_151AA2",
   "texts": {
    "Route120_Text_1BF65B": "Why am I carrying this parasol?\\pI'll tell you if you can win against me.$",
    "Route120_Text_1BF6A4": "A parasol can't ward off POKéMON\\nattacks...$",
    "Route120_Text_1BF6D0": "I don't think strong sunlight is good\\nfor my POKéMON.\\lSo I shield them with my parasol.$"
   },
   "complex": true
  },
  {
   "local_id": 27,
   "x": 18,
   "y": 34,
   "gfx": "OBJ_EVENT_GFX_WOMAN_7",
   "movement": "MOVEMENT_TYPE_FACE_DOWN_AND_LEFT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route120_EventScript_151AB9",
   "texts": {
    "Route120_Text_1BF728": "Me, POKéMON, and my parasol...\\pIf any one of them is missing, the\\npicture of beauty will be ruined.$",
    "Route120_Text_1BF78C": "You've completely ruined my beauty...$",
    "Route120_Text_1BF7B2": "A parasol wouldn't suit you at all.\\pWhy, something like this would only\\nget in your way.$"
