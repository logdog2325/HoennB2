   "script": "Route129_EventScript_152366",
   "texts": {
    "Route129_Text_1C2161": "This is my first triathlon.\\nI'm all tense and nervous!$",
    "Route129_Text_1C2198": "Wroooaaar!\\nI failed to win!$",
    "Route129_Text_1C21B4": "If I'm all tensed up, I won't be able to\\ngive it my all.$"
