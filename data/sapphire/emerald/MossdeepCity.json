   "hide_flag": "0",
   "script": "MossdeepCity_EventScript_PokefanF",
   "texts": {
    "MossdeepCity_Text_SpaceCenterReceivedLetter": "The island's SPACE CENTER has been\\nlaunching huge rockets.\\pThere's been some kind of an uproar\\nover a letter they received recently.$"
   },
   "complex": true
