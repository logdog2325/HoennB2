   "script": "SlateportCity_EventScript_CaptStern",
   "texts": {
    "SlateportCity_Text_SternMoveAheadWithExploration": "CAPT. STERN: Yes, indeed. We intend to\\nmove ahead with our exploration.$",
    "SlateportCity_Text_GabbyWonderfulThanksForInterview": "GABBY: That's wonderful, CAPT. STERN!\\nThank you for taking the time from\\lyour busy schedule to talk to us.\\pWe hope we can interview you again\\nwith news of more discoveries!$",
    "SlateportCity_Text_SternWhewFirstInterview": "CAPT. STERN: Whew...\\pThat was my first time to be filmed for\\nTV. That was nerve wracking.$",
    "SlateportCity_Text_OhPlayerWeMadeDiscovery": "Oh! {PLAYER}{KUN}!\\nYou're looking great!\\pWe made a huge discovery on our last\\nseafloor exploration.\\pWe found an underwater cavern on\\nROUTE 128.\\pWe think it's the habitat of a POKéMON\\nthat's said to have been long extinct.$",
    "SlateportCity_Text_EvilTeamWillAssumeControlOfSubmarine": "Fufufu...\\nCAPT. STERN, I presume.\\pWe of TEAM {EVIL_TEAM} will assume\\ncontrol of your submarine!\\pYour objections are meaningless!\\nWe expect your total cooperation!\\pFufufu...\\nJust watch and learn what TEAM\\l{EVIL_TEAM} has planned!$",
    "SlateportCity_Text_SternWhatWasAllThat": "CAPT. STERN: What was that all about?\\pIt sounded like someone using a\\nmegaphone...\\pWhere did it come from?$",
    "SlateportCity_Text_FromHarborTryingToTakeSub": "It's from the HARBOR!\\pThe submarine!\\nThey're trying to take it!$",
    "SlateportCity_Text_PleaseComeWithMe": "{PLAYER}{KUN}!\\nPlease, come with me!$"
   },
   "complex": true
