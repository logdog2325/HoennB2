   "hide_flag": "0",
   "script": "JaggedPass_EventScript_Diana",
   "texts": {
    "JaggedPass_Text_DianaIntro": "This place isn't your casual hike.\\nIt's not suited for a picnic.$",
    "JaggedPass_Text_DianaDefeat": "Ohhh, no!\\nThe ground is too bumpy…$",
    "JaggedPass_Text_DianaPostBattle": "Did you know?\\pSome people cleverly ride their\\nbicycles up this horribly bumpy pass.$"
   },
   "complex": true
  },
  {
   "local_id": 5,
   "x": 16,
   "y": 19,
   "gfx": "OBJ_EVENT_GFX_MAGMA_MEMBER_M",
   "movement": "MOVEMENT_TYPE_FACE_UP",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "FLAG_HIDE_JAGGED_PASS_MAGMA_GUARD",
   "script": "JaggedPass_EventScript_MagmaHideoutGuard",
   "texts": {
    "JaggedPass_Text_GruntIntro": "Wah!\\nWhat are you doing here?\\pWhat am I doing in a place like this?\\pWhat business is it of yours?$",
    "JaggedPass_Text_GruntDefeat": "Urrrgh…\\pI should've ducked into our HIDEOUT\\nright away…$"
   },
   "complex": true
  },
  {
   "local_id": 6,
