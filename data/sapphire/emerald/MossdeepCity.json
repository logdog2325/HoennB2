   "texts": {
    "MossdeepCity_Text_WantKingsRockStevenGaveMe": "I got this from STEVEN, but I don't\\nknow what it's good for.\\pI think it's called KING'S ROCK.\\nDo you want it?$",
    "MossdeepCity_Text_YouCanKeepIt": "Why would you want it?\\nYou're weird.\\pYou can keep it, but keep it a secret\\nfrom STEVEN.$"
