   "texts": {
    "Route121_Text_1BF96E": "Will you play with my delightfully\\npretty POKéMON?$",
    "Route121_Text_1BF9A1": "This isn't what I meant!$",
    "Route121_Text_1BF9BA": "I'm going to a CONTEST in LILYCOVE.\\pMy POKéMON should have no problem\\nsweeping the MASTER CLASS.$"
