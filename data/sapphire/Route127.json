  {
   "local_id": 5,
   "x": 53,
   "y": 13,
   "gfx": "OBJ_EVENT_GFX_FISHERMAN",
   "movement": "MOVEMENT_TYPE_FACE_UP",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route127_EventScript_1520A8",
   "texts": {
    "Route127_Text_1C18CC": "Through fishing, I have attained a\\nstate of becalmed serenity...\\lPlease, allow me to demonstrate...$",
    "Route127_Text_1C1930": "Though I have lost, my heart remains\\ncalm...$",
    "Route127_Text_1C195D": "It matters not that I catch nothing.\\nThe line remains in the water...$"
   },
   "complex": true
  },
  {
   "local_id": 6,
   "x": 52,
   "y": 25,
   "gfx": "OBJ_EVENT_GFX_FISHERMAN",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route127_EventScript_1520D6",
   "texts": {
    "Route127_Text_1C1A2E": "Well, hey! This is a match between a\\nPOKéMON fan and a fishing buff!$",
    "Route127_Text_1C1A73": "No! My line's all tangled!\\nThe party's over!$",
    "Route127_Text_1C1AA0": "My fishing line's doing a dance!\\nThe tangle tango! Hahaha, snarl!$"
   },
   "complex": true
  },
  {
   "local_id": 7,
   "x": 64,
   "y": 19,
   "gfx": "OBJ_EVENT_GFX_FISHERMAN",
   "movement": "MOVEMENT_TYPE_FACE_RIGHT",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route127_EventScript_1520BF",
   "texts": {
    "Route127_Text_1C19A3": "Whoops! Don't tell me I snagged\\na SURFING POKéMON?$",
    "Route127_Text_1C19D6": "I can't keep up!$",
    "Route127_Text_1C19E7": "Your POKéMON look pretty strong.\\nThey'd be a handful if I hooked them!$"
   },
   "complex": true
  },
  {
   "local_id": 8,
   "x": 12,
   "y": 18,
   "gfx": "OBJ_EVENT_GFX_MAN_6",
   "movement": "MOVEMENT_TYPE_ROTATE_CLOCKWISE",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route127_EventScript_152104",
   "texts": {
    "Route127_Text_1C1B92": "BIRD POKéMON have excellent vision.\\nThey spot prey from great heights.$",
    "Route127_Text_1C1BD9": "Whew... I give up.$",
    "Route127_Text_1C1BEC": "There're lots of diving spots in the\\nsea around here.\\pYou can spot them easily from the sky\\nbecause of their darker color.$"
   },
   "complex": true
  },
  {
   "local_id": 9,
   "x": 63,
   "y": 63,
   "gfx": "OBJ_EVENT_GFX_BLACK_BELT",
   "movement": "MOVEMENT_TYPE_LOOK_AROUND",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route127_EventScript_1520ED",
   "texts": {
    "Route127_Text_1C1AE2": "What I learned at DEWFORD's POKéMON\\nGYM, I will put into practice here.$",
    "Route127_Text_1C1B2A": "I was swamped!$",
    "Route127_Text_1C1B39": "BRAWLY, DEWFORD's GYM LEADER, used\\nto train with a guy named BRUNO in\\lKANTO, I've heard.$"
   },
   "complex": true
  }
