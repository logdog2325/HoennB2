   "hide_flag": "0",
   "script": "JaggedPass_EventScript_Julio",
   "texts": {
    "JaggedPass_Text_JulioIntro": "Aiyeeh! It's awfully scary to shoot\\ndown the mountain in one go!$",
    "JaggedPass_Text_JulioDefeat": "I feel like I'm falling apart…$",
    "JaggedPass_Text_JulioPostBattle": "My bicycle bounced around so much,\\nmy rear end's sore…$"
   },
   "complex": true
