   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route112_EventScript_15059E",
   "texts": {
    "Route112_Text_1BB893": "I'm strong.\\nI won't cry if I lose.$",
    "Route112_Text_1BB8B6": "Waaaah!$",
    "Route112_Text_1BB8BE": "I'm not crying because I miss my mommy!\\nSnivel...$"
