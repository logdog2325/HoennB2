   "hide_flag": "0",
   "script": "Route133_EventScript_152587",
   "texts": {
    "Route133_Text_1C2F53": "I want to win like everyone else, but I\\nwon't raise POKéMON like everyone else.$",
    "Route133_Text_1C2FA3": "Darn it!\\nMy way is still too slack!$",
    "Route133_Text_1C2FC7": "It's way more fun to do things the way\\nI want than to be like everybody else.\\lI mean, that's obvious!$"
   },
   "complex": true
