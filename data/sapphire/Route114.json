   "script": "Route114_EventScript_150912",
   "texts": {
    "Route114_Text_1BC8D8": "IVY: Who taught you about POKéMON?$",
    "Route114_Text_1BC8FB": "IVY: What an amazing battle style!$",
    "Route114_Text_1BC96A": "IVY: Do you only have one POKéMON?\\nI think it must feel lonesome.$",
    "Route114_Text_1BC91E": "IVY: I started training POKéMON\\nbecause TYRA, my student mentor,\\ltaught me!$"
   },
   "complex": true
  },
  {
   "local_id": 23,
   "x": 23,
   "y": 44,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route114_EventScript_1508F7",
   "texts": {
    "Route114_Text_1BC7E3": "TYRA: Well, sure.\\nI'm in the mood for it.\\lI'll teach you a little about POKéMON.$",
    "Route114_Text_1BC834": "TYRA: What an amazing battle style!$",
    "Route114_Text_1BC88A": "TYRA: Giggle...\\nIf you want to battle with us, just one\\lPOKéMON isn't enough!$",
    "Route114_Text_1BC858": "TYRA: I was teaching my junior IVY\\nabout POKéMON.$"
   },
   "complex": true
