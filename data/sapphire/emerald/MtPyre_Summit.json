   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "0",
   "script": "MtPyre_Summit_EventScript_OldMan",
   "texts": {
    "MtPyre_Summit_Text_WillYouHearOutMyTale": "MT. PYRE is where we calm the spirits\\nof POKéMON that have passed on…\\pThis is a high place where one can\\nsee all of HOENN…\\pThe disembodied spirits of POKéMON\\nmust find solace here…\\pIs it coincidence that you are here…\\pWill you hear out my tale? A tale long\\ntold in the HOENN region?$"
   },
   "complex": true
  },
  {
   "local_id": 2,
   "x": 23,
   "y": 6,
   "gfx": "OBJ_EVENT_GFX_ARCHIE",
   "movement": "MOVEMENT_TYPE_FACE_UP",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "FLAG_HIDE_MT_PYRE_SUMMIT_ARCHIE",
   "script": "0x0",
   "missing": true
  },
  {
   "local_id": 3,
   "x": 23,
   "y": 5,
   "gfx": "OBJ_EVENT_GFX_EXPERT_F",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "0",
   "script": "MtPyre_Summit_EventScript_OldLady",
   "texts": {
    "MtPyre_Summit_Text_OrbsHaveBeenTaken": "The BLUE ORB and RED ORB taken by\\nthose sinister men…\\pThey must never be apart…\\nI fear something terrible will happen…$"
   },
   "complex": true
  },
  {
   "local_id": 4,
   "x": 21,
   "y": 15,
   "gfx": "OBJ_EVENT_GFX_AQUA_MEMBER_M",
   "movement": "MOVEMENT_TYPE_FACE_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "FLAG_HIDE_MT_PYRE_SUMMIT_TEAM_AQUA",
   "script": "MtPyre_Summit_EventScript_Grunt1",
   "texts": {
    "MtPyre_Summit_Text_Grunt1Intro": "No! Those TEAM MAGMA goons got\\nhere ahead of us!\\pWe can't fall behind!$",
    "MtPyre_Summit_Text_Grunt1Defeat": "I thought you were one of the MAGMAS\\nwho happened to come back…$",
    "MtPyre_Summit_Text_Grunt1PostBattle": "Yeah, so you are strong…\\nBut there're a lot of us!$"
   },
   "complex": true
  },
  {
   "local_id": 5,
   "x": 25,
   "y": 18,
   "gfx": "OBJ_EVENT_GFX_AQUA_MEMBER_M",
   "movement": "MOVEMENT_TYPE_FACE_LEFT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "FLAG_HIDE_MT_PYRE_SUMMIT_TEAM_AQUA",
   "script": "MtPyre_Summit_EventScript_Grunt2",
   "texts": {
    "MtPyre_Summit_Text_Grunt2Intro": "Hah!\\nToo bad for you!\\pIf you came earlier, you only would've\\nhad to battle the wimpy TEAM MAGMA.\\pBut since you arrived now, you have\\nto take on us toughies!$",
    "MtPyre_Summit_Text_Grunt2Defeat": "Urgh… I should've let you take on\\nTEAM MAGMA first…$",
    "MtPyre_Summit_Text_Grunt2PostBattle": "You don't know anything!\\nSo why are you messing with us?$"
   },
   "complex": true
  },
  {
   "local_id": 6,
   "x": 21,
   "y": 11,
   "gfx": "OBJ_EVENT_GFX_AQUA_MEMBER_M",
   "movement": "MOVEMENT_TYPE_FACE_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "FLAG_HIDE_MT_PYRE_SUMMIT_TEAM_AQUA",
   "script": "MtPyre_Summit_EventScript_Grunt3",
   "texts": {
    "MtPyre_Summit_Text_Grunt3Intro": "You…\\nWe saw you at MT. CHIMNEY.\\pYou don't belong to either TEAM,\\nso why would you be here?$",
    "MtPyre_Summit_Text_Grunt3Defeat": "If you're going to mess with anyone,\\nlet it be TEAM MAGMA…$",
    "MtPyre_Summit_Text_Grunt3PostBattle": "Heh, it doesn't matter!\\nWe bought ourselves some time!\\pThe BOSS should have snatched what\\nhe was after!$"
   },
   "complex": true
  },
  {
   "local_id": 7,
   "x": 25,
   "y": 11,
   "gfx": "OBJ_EVENT_GFX_AQUA_MEMBER_F",
   "movement": "MOVEMENT_TYPE_FACE_LEFT",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "FLAG_HIDE_MT_PYRE_SUMMIT_TEAM_AQUA",
   "script": "MtPyre_Summit_EventScript_Grunt4",
   "texts": {
    "MtPyre_Summit_Text_Grunt4Intro": "Oh, I know!\\nYou tried to join TEAM MAGMA,\\lbut they wouldn't have you!\\pWell, don't think that we'll let you\\njoin our TEAM AQUA!$",
    "MtPyre_Summit_Text_Grunt4Defeat": "If you want to join TEAM AQUA that\\nbadly, we can consider it…$",
    "MtPyre_Summit_Text_Grunt4PostBattle": "We have a great combination going\\nwith us members and our leader.$"
   },
   "complex": true
  },
  {
