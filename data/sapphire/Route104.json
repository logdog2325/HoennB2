   "script": "Route104_EventScript_14EF42",
   "texts": {
    "Route104_Text_16DA13": "That seaside cottage is where\\nMR. BRINEY lives.\\pHe was once a mighty sailor who never\\nfeared the sea, however stormy.$"
   }
