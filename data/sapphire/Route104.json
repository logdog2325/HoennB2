   "script": "Route104_EventScript_14EF81",
   "texts": {
    "Route104_Text_16DAC9": "If you're going to throw a POKé BALL,\\nweaken the wild POKéMON first.\\pIt will be easier to catch if it's been\\npoisoned, burned, or lulled to sleep.$"
   }
  },
  {
