   "script": "Route117_EventScript_Anna",
   "texts": {
    "Route117_Text_AnnaIntro": "ANNA: I'm with my pretty junior student\\npartner. I have to do good!$",
    "Route117_Text_AnnaDefeat": "ANNA: I'm with my pretty junior student\\npartner! Let me win!$",
    "Route117_Text_AnnaNotEnoughMons": "ANNA: If you want to battle us,\\nbring two POKéMON with you.$",
    "Route117_Text_AnnaPostBattle": "ANNA: Your POKéMON have some good\\ncombinations.\\pI'd say you're second only to us!$"
   },
   "complex": true
