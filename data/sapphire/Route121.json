   "script": "Route121_EventScript_151B89",
   "texts": {
    "Route121_Text_1BFA1B": "With my POKéMON, I have traveled the\\nworld's four corners.\\pYou might say I have some confidence\\nin my abilities.$",
    "Route121_Text_1BFA8C": "Ah, well played.$",
    "Route121_Text_1BFA9D": "I would like to circle the globe once\\nagain with my POKéMON.$"
   },
   "complex": true
  },
