   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "FLAG_HIDE_GABBY_AND_TY_ROUTE120_1",
   "script": "Route120_EventScript_1AE4C2",
   "texts": {
    "Route120_Text_1AC790": "TY: Hey, lookie here!\\nI remember you!\\pI'll get this battle all on this\\nhere camera!$",
    "Route120_Text_1AC8D7": "TY: Yep, I got it all.\\nThat whole battle's on camera.$",
    "Route120_Text_1AC820": "TY: Do you only have the one POKéMON\\nand that's it?\\pIf you had more POKéMON, it'd make for\\nbetter footage, but...$",
    "Route120_Text_1AC7E4": "TY: You're a natural!\\nGot me some prime footage right here!$"
   },
   "complex": true
  },
  {
   "local_id": 18,
   "x": 36,
   "y": 5,
   "gfx": "OBJ_EVENT_GFX_REPORTER_F",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NONE",
   "hide_flag": "FLAG_HIDE_GABBY_AND_TY_ROUTE120_1",
   "script": "Route120_EventScript_1AE4A2",
   "texts": {
    "Route120_Text_1ABF50": "GABBY: Oh! You're {PLAYER}! Hi!\\nDo you remember us from last time?\\pCan you show us how much stronger\\nyou've become? Okay, cue interview!$",
    "Route120_Text_1AC6F8": "GABBY: That was an intense battle!\\nDid you get all that on camera?$",
    "Route120_Text_1AC5CA": "GABBY: Is there a strong TRAINER\\nanywhere with a lot of POKéMON?$",
    "Route120_Text_1AC59E": "GABBY: We'll be keeping an eye out\\nfor you!$"
   },
   "complex": true
  },
