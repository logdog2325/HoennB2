   "script": "Route108_EventScript_14F476",
   "texts": {
    "Route108_Text_1B97C3": "My dream is to swim the world's seven\\nseas!$",
    "Route108_Text_1B97EF": "I won't be able to swim the seven seas\\nlike this...$",
    "Route108_Text_1B9823": "Playing with marine POKéMON is one of\\nthe pleasures of swimming!$"
