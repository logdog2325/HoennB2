   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "JaggedPass_EventScript_Autumn",
   "texts": {
    "JaggedPass_Text_AutumnIntro": "I climb this hill every day.\\nI have confidence in my strength!$",
    "JaggedPass_Text_AutumnDefeat": "Hmm…\\nWhat went wrong?$",
    "JaggedPass_Text_AutumnPostBattle": "What is that odd rock protrusion\\na little up the hill from here?$"
   },
   "complex": true
  },
  {
