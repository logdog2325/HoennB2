   "hide_flag": "0",
   "script": "Route125_EventScript_Auron",
   "texts": {
    "Route125_Text_AuronIntro": "Hey! Was it you throwing garbage\\ninto the sea?$",
    "Route125_Text_AuronDefeat": "Oh, you weren't throwing trash into\\nthe sea.$",
    "Route125_Text_AuronPostBattle": "I found an unsightly bottle bobbing\\nin the waves earlier.\\pIt angers me that someone would\\npollute the sea!$"
