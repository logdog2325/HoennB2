   "hide_flag": "0",
   "script": "Route108_EventScript_14F4A4",
   "texts": {
    "Route108_Text_1B98EC": "My liar of a boyfriend told me that\\nI look great in a bikini...$",
    "Route108_Text_1B992C": "Oh, boo!$",
    "Route108_Text_1B9935": "Even if it's a lie, I love being told\\nI look great...\\lWe girls are so complex...$"
   },
   "complex": true
  },
  {
   "local_id": 3,
