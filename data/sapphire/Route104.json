   "hide_flag": "0",
   "script": "Route104_EventScript_14EF8A",
   "texts": {
    "Route104_Text_16DB5C": "You're a thief if you try to steal\\nsomeone else's POKéMON.\\pYou should throw POKé BALLS only at\\nwild POKéMON.$"
   }
