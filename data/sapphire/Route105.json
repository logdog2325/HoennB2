   "hide_flag": "0",
   "script": "Route105_EventScript_14F2BB",
   "texts": {
    "Route105_Text_1B8B40": "There's supposed to be a mystical\\nrock around here.\\lDo you know anything about it?$",
    "Route105_Text_1B8B93": "I was thinking too much about that\\nrock, while my POKéMON remained weak...$",
    "Route105_Text_1B8BDE": "I can spend hours and hours staring\\nat a nice rock without growing bored.$"
   },
   "complex": true
