   "script": "Route110_EventScript_14F9D4",
   "texts": {
    "Route110_Text_16EEF6": "Which should I choose?\\pMake a beeline for MAUVILLE on\\nCYCLING ROAD, or take the low road\\land look for POKéMON?$"
