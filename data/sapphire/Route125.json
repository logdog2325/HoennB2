 "npcs": [
  {
   "local_id": 1,
   "x": 46,
   "y": 9,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_M",
   "movement": "MOVEMENT_TYPE_ROTATE_COUNTERCLOCKWISE",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151F2E",
   "texts": {
    "Route125_Text_1C0FCF": "I heard you approaching, so I hung\\naround for you!$",
    "Route125_Text_1C1002": "I beg for peace!$",
    "Route125_Text_1C1013": "Sound travels faster in water than\\nit does through air.$"
   },
   "complex": true
  },
  {
   "local_id": 2,
   "x": 9,
   "y": 32,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_M",
   "movement": "MOVEMENT_TYPE_FACE_RIGHT",
   "range": [
    2,
    5
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151F45",
   "texts": {
    "Route125_Text_1C104B": "Hey, there!\\nCheck out my sweet POKéMON!$",
    "Route125_Text_1C1073": "I floundered...$",
    "Route125_Text_1C1083": "I was blown away by HORSEA's charm,\\nso I started swimming, too.$"
   },
   "complex": true
  },
  {
   "local_id": 3,
   "x": 31,
   "y": 33,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_F",
   "movement": "MOVEMENT_TYPE_WALK_RIGHT_AND_LEFT",
   "range": [
    6,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151F5C",
   "texts": {
    "Route125_Text_1C10C3": "I'm tired of swimming.\\nAre you up for a battle with me?$",
    "Route125_Text_1C10FB": "You're too much!$",
    "Route125_Text_1C110C": "Whew...\\nWhich way is it to MOSSDEEP CITY?$"
   },
   "complex": true
  },
  {
   "local_id": 4,
   "x": 39,
   "y": 20,
   "gfx": "OBJ_EVENT_GFX_SWIMMER_F",
   "movement": "MOVEMENT_TYPE_WALK_SEQUENCE_RIGHT_DOWN_LEFT_UP",
   "range": [
    9,
    9
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151F73",
   "texts": {
    "Route125_Text_1C1136": "How would you like to take on the\\nWATER-type POKéMON I raised?$",
    "Route125_Text_1C1175": "I lost...$",
    "Route125_Text_1C117F": "Your power... You're the real deal.\\nI'm amazed!$"
   },
   "complex": true
  },
  {
   "local_id": 5,
   "x": 23,
   "y": 28,
   "gfx": "OBJ_EVENT_GFX_SAILOR",
   "movement": "MOVEMENT_TYPE_FACE_LEFT_AND_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151F8A",
   "texts": {
    "Route125_Text_1C11AF": "Ahoy! I'm a buff, tough SAILOR!\\nI've braved the world's seas!$",
    "Route125_Text_1C11ED": "Gwrroooar!\\nI couldn't win!$",
    "Route125_Text_1C1208": "The tide ebbs and flows inside the\\nSHOAL CAVE.\\pBy the way, it's about six hours from\\nhigh tide to low tide. Did you know?$"
   },
   "complex": true
  },
  {
   "local_id": 6,
   "x": 20,
   "y": 21,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151FC8",
   "texts": {
    "Route125_Text_1C13A1": "KIM: A funny old man lives in the\\nSHOAL CAVE. Someone told me.\\lAre you going to see him, too?$",
    "Route125_Text_1C13FF": "KIM: I thought we would win.$",
    "Route125_Text_1C146E": "KIM: No, no, no! You need two POKéMON,\\nor it's just no good!$",
    "Route125_Text_1C141C": "KIM: A funny old man lives in the\\nSHOAL CAVE, doesn't he?\\pLet's go see him, IRIS!$"
   },
   "complex": true
  },
  {
   "local_id": 7,
   "x": 21,
   "y": 21,
   "gfx": "OBJ_EVENT_GFX_LASS",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    1,
    1
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route125_EventScript_151FE3",
   "texts": {
    "Route125_Text_1C14AB": "IRIS: KIM, can you tell me what we're\\nlooking for out here?$",
    "Route125_Text_1C14E7": "IRIS: Oh, we came sort of close.$",
    "Route125_Text_1C154F": "IRIS: Oh, we could never, ever do\\nanything like a 2-on-1 battle.$",
    "Route125_Text_1C1508": "IRIS: KIM, are we really going into\\nthe SHOAL CAVE?\\lWe'll get all wet.$"
   },
   "complex": true
  }
 ],
