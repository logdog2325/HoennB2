   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route127_EventScript_152091",
   "texts": {
    "Route127_Text_1C1828": "Do you have a rival whom you just\\nhate to lose against?$",
    "Route127_Text_1C1860": "Arrrgh! I hate losing!$",
    "Route127_Text_1C1877": "If you have a rival, don't you get the\\nfeeling that you have to keep getting\\lbetter?$"
   },
   "complex": true
  },
