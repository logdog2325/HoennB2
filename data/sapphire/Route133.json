   "texts": {
    "Route133_Text_1C302D": "I came all the way out here with my\\nBIRD POKéMON.$",
    "Route133_Text_1C305F": "You...\\nYou're stunningly cool!$",
    "Route133_Text_1C307E": "I'd like to go back to FORTREE, but I've\\ngrown to like this place, too.$"
