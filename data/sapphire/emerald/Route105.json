   "script": "Route105_EventScript_Imani",
   "texts": {
    "Route105_Text_ImaniIntro": "The blue, blue sky…\\nThe vast sea…\\lIt's so peaceful…$",
    "Route105_Text_ImaniDefeated": "I lost while I was lounging!$",
    "Route105_Text_ImaniPostBattle": "I want to be told I'm relaxing to be\\nwith. Giggle.$"
   },
   "complex": true
  },
