   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route105_EventScript_Josue",
   "texts": {
    "Route105_Text_JosueIntro": "I'm exhausted from swimming.\\nI'm just not used to it.\\pI need a battle for a change of pace!$",
    "Route105_Text_JosueDefeated": "I lost because I battled at sea.$",
    "Route105_Text_JosuePostBattle": "Yeah, for me, the sky is a much better\\nmatch than the sea.$"
   },
   "complex": true
  },
  {
   "local_id": 8,
