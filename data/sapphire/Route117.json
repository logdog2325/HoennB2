   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150E09",
   "texts": {
    "Route117_Text_1BD79A": "I'm in the middle of a triathlon, but,\\nwhatever, let's have a battle!$",
    "Route117_Text_1BD7E0": "I ran out of energy!$",
    "Route117_Text_1BD7F5": "I may have blown it...\\pI might have dropped to last during\\nthat battle...$"
   },
   "complex": true
  },
  {
   "local_id": 9,
   "x": 31,
   "y": 11,
   "gfx": "OBJ_EVENT_GFX_WOMAN_3",
   "movement": "MOVEMENT_TYPE_ROTATE_COUNTERCLOCKWISE",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150DCB",
   "texts": {
    "Route117_Text_1BD634": "Please, allow me to evaluate if you\\nhave raised your POKéMON properly.$",
    "Route117_Text_1BD67B": "Yes, they are growing properly.$",
    "Route117_Text_1BD69B": "If you feed {POKEBLOCK}S to POKéMON, the\\nunique aspects of their character\\lwill be enhanced.$"
   },
   "complex": true
  },
  {
   "local_id": 10,
   "x": 10,
   "y": 9,
   "gfx": "OBJ_EVENT_GFX_MAN_5",
   "movement": "MOVEMENT_TYPE_FACE_DOWN_AND_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route117_EventScript_150D8D",
   "texts": {
    "Route117_Text_1BD49E": "Listen, could I get you to battle the\\nPOKéMON I'm raising?$",
    "Route117_Text_1BD4D9": "You've raised yours superbly...$",
    "Route117_Text_1BD4F9": "POKéMON isn't all about power.\\pPolishing a unique aspect of one's\\ncharacter is another way of enjoying\\lPOKéMON.$"
   },
   "complex": true
  },
