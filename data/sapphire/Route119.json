   "script": "Route119_EventScript_15153B",
   "texts": {
    "Route119_Text_1BEBC0": "The vast sky holds untold promise!\\pNothing can compare to the sheer\\nexhilaration of flight!$",
    "Route119_Text_1BEC1C": "Down and out!$",
    "Route119_Text_1BEC2A": "My BIRD POKéMON made my dreams of\\nflying come true!$"
