   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route108_EventScript_14F48D",
   "texts": {
    "Route108_Text_1B9864": "Ahoy, there! Are you going out to the\\nABANDONED SHIP, too?$",
    "Route108_Text_1B989F": "I'm sinking!\\nGlub... Glub...$",
    "Route108_Text_1B98BC": "Some people even go inside that\\nABANDONED SHIP.$"
