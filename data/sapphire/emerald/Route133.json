   "hide_flag": "0",
   "script": "Route133_EventScript_Warren",
   "texts": {
    "Route133_Text_WarrenIntro": "I want to win like everyone else, but I\\nwon't raise POKéMON like everyone else.$",
    "Route133_Text_WarrenDefeat": "Darn it!\\nMy way is still too slack!$",
    "Route133_Text_WarrenPostBattle": "It's way more fun to do things the way\\nI want than to be like everybody else.\\lI mean, that's obvious!$"
   },
   "complex": true
  },
