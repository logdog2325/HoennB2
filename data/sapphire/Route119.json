  {
   "local_id": 4,
   "x": 12,
   "y": 123,
   "gfx": "OBJ_EVENT_GFX_BUG_CATCHER",
   "movement": "MOVEMENT_TYPE_COPY_PLAYER_IN_GRASS",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_151491",
   "texts": {
    "Route119_Text_1BE784": "You don't know who I am, do you?\\pBut, I also don't know you.\\nSo, we'll battle!$",
    "Route119_Text_1BE7D3": "You're pretty strong!$",
    "Route119_Text_1BE7E9": "Until you go away somewhere, we'll\\nkeep on mimicking your every move.$"
   },
   "complex": true
  },
  {
   "local_id": 5,
   "x": 26,
   "y": 123,
   "gfx": "OBJ_EVENT_GFX_MANIAC",
   "movement": "MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE_IN_GRASS",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_151463",
   "texts": {
    "Route119_Text_1BE632": "If you step forward, we step forward.\\pIf you turn right, we turn, too...$",
    "Route119_Text_1BE67B": "But if you win, I lose...$",
    "Route119_Text_1BE695": "I can't MIMIC you winning the match.\\nThat's just impossible...\\lIt's burning me up...$"
   },
   "complex": true
  },
  {
   "local_id": 6,
   "x": 5,
   "y": 125,
   "gfx": "OBJ_EVENT_GFX_MANIAC",
   "movement": "MOVEMENT_TYPE_COPY_PLAYER_CLOCKWISE_IN_GRASS",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_15144C",
   "texts": {
    "Route119_Text_1BE5A4": "So, we finally meet!\\nMy BUG POKéMON will keep you company!$",
    "Route119_Text_1BE5DF": "I wish we'd never met...$",
    "Route119_Text_1BE5F8": "I want to MIMIC you some more.\\pCan you hurry up and move?$"
   },
   "complex": true
  },
  {
   "local_id": 7,
   "x": 7,
   "y": 74,
   "gfx": "OBJ_EVENT_GFX_CAMPER",
   "movement": "MOVEMENT_TYPE_FACE_DOWN_AND_RIGHT",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_1514BF",
   "texts": {
    "Route119_Text_1BE8BB": "Who has the knowledge and the\\ntechnique for survival?\\pPOKéMON RANGERS, that's who!$",
    "Route119_Text_1BE90E": "I didn't have enough POKéMON\\nknow-how...$",
    "Route119_Text_1BE937": "To break away from civilization and\\nawaken the wild spirit within!\\pThat's our vision.$"
   },
   "complex": true
  },
  {
   "local_id": 8,
   "x": 28,
   "y": 116,
   "gfx": "OBJ_EVENT_GFX_MANIAC",
   "movement": "MOVEMENT_TYPE_COPY_PLAYER_OPPOSITE_IN_GRASS",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_151435",
   "texts": {
    "Route119_Text_1BE521": "We're the MIMIC CIRCLE!\\nWe MIMIC what you do!$",
    "Route119_Text_1BE54F": "Whoopsie!\\nI lost!$",
    "Route119_Text_1BE561": "What's so good about mimicry?\\pFufufu...\\nYou'll never understand...$"
   },
   "complex": true
  },
  {
   "local_id": 9,
   "x": 35,
   "y": 83,
   "gfx": "OBJ_EVENT_GFX_PICNICKER",
   "movement": "MOVEMENT_TYPE_FACE_DOWN",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_1514FD",
   "texts": {
    "Route119_Text_1BEA3A": "Oh? Look at you.\\pFor someone on an adventure, you're\\ntraveling awfully light.$",
    "Route119_Text_1BEA88": "Accidents happen when you're not\\nprepared!$",
    "Route119_Text_1BEAB3": "You're traveling light but you have\\neverything you need.\\pYou're on top of things mentally and\\nphysically, too.$"
   },
   "complex": true
  },
  {
   "local_id": 10,
   "x": 34,
   "y": 122,
   "gfx": "OBJ_EVENT_GFX_BUG_CATCHER",
   "movement": "MOVEMENT_TYPE_COPY_PLAYER_COUNTERCLOCKWISE_IN_GRASS",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_15147A",
   "texts": {
    "Route119_Text_1BE6EA": "Yep, you've finally caught me!\\nOr were you trying to avoid me?$",
    "Route119_Text_1BE729": "Whoop, that was a great match!$",
    "Route119_Text_1BE748": "We're the MIMIC CIRCLE!\\nI hope you enjoyed our performance.$"
   },
   "complex": true
  },
  {
   "local_id": 11,
   "x": 17,
   "y": 128,
   "gfx": "OBJ_EVENT_GFX_BUG_CATCHER",
   "movement": "MOVEMENT_TYPE_COPY_PLAYER_COUNTERCLOCKWISE_IN_GRASS",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_1514A8",
   "texts": {
    "Route119_Text_1BE82F": "The MIMIC CIRCLE was formed by people\\nwho like to MIMIC.\\pA battle starts the instant we meet!$",
    "Route119_Text_1BE88D": "I surrender!$",
    "Route119_Text_1BE89A": "Won't you join our MIMIC CIRCLE?$"
   },
   "complex": true
  },
  {
   "local_id": 12,
   "x": 28,
   "y": 16,
   "gfx": "OBJ_EVENT_GFX_LITTLE_BOY_1",
   "movement": "MOVEMENT_TYPE_TREE_DISGUISE",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_151569",
   "texts": {
    "Route119_Text_1BECF1": "To lurk in shadows, and live in\\ndarkness... That is my destiny.\\pI emerge to challenge you!$",
    "Route119_Text_1BED4C": "I admit defeat!$",
    "Route119_Text_1BED5C": "Those defeated in battle withdraw\\nquietly back into the shadows.\\lThat, too, is destiny...$"
   },
   "complex": true
  },
  {
   "local_id": 13,
   "x": 19,
   "y": 49,
   "gfx": "OBJ_EVENT_GFX_LITTLE_BOY_1",
   "movement": "MOVEMENT_TYPE_MOUNTAIN_DISGUISE",
   "range": [
    0,
    0
   ],
   "trainer_type": "TRAINER_TYPE_NORMAL",
   "hide_flag": "0",
   "script": "Route119_EventScript_151580",
   "texts": {
    "Route119_Text_1BEDB6": "If you're not on your guard, you're in\\nfor some pain!$",
    "Route119_Text_1BEDEC": "You're surprisingly good!$",
    "Route119_Text_1BEE06": "My surprise attack ended in\\nfailure...$"
   },
   "complex": true
  },
  {
   "local_id": 14,
   "x": 10,
   "y": 50,
   "gfx": "OBJ_EVENT_GFX_MAN_6",
