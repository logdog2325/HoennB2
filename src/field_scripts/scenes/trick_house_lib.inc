    ObjInitWarpGPos \warpidx, 14, 0, 2   // Sapphire (13,1): setmetatile 13, 1, Stairs_Down
.Lthdo\@:
    h_release
.Lthdl\@:
    th_info \tlocked
    h_release
    .endm
