   "script": "Route125_EventScript_Nolen",
   "texts": {
    "Route125_Text_NolenIntro": "I heard you approaching, so I hung\\naround for you!$",
    "Route125_Text_NolenDefeat": "I surrender!$",
    "Route125_Text_NolenPostBattle": "Sound travels faster in water than\\nit does through air.$"
